# Public values only in NEXT_PUBLIC_*; copy to .env.local when configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=
# API local development (pass using Deno --env-file=.env.local if needed)
ALLOWED_ORIGINS=http://localhost:3000
POC_MODE=false
PORT=8000
# Supabase injects SUPABASE_URL and server-side keys in hosted functions.
# Never put service-role, SMS or gateway secrets in NEXT_PUBLIC_*.
# Preview-only public fixture adapter; keep false for normal builds.
NEXT_PUBLIC_POC_EVENT_FIXTURES=false
