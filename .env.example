# Browser config. These values are embedded into the static JavaScript bundle.
NEXT_PUBLIC_SUPABASE_URL=https://fpbefabsqryxmnmxufjw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=https://fpbefabsqryxmnmxufjw.supabase.co/functions/v1/dolend-api/v1
NEXT_PUBLIC_POC_EVENT_FIXTURES=false

# Local Elysia/Deno config. Hosted Edge Functions receive SUPABASE_URL and keys
# from Supabase; do not copy the service-role key into NEXT_PUBLIC_*.
SUPABASE_URL=https://fpbefabsqryxmnmxufjw.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required by the guest-booking RPC; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only credential for scheduled maintenance endpoints.
INTERNAL_JOB_KEY=
# Server-only, optional for external venue search.
GEOAPIFY_API_KEY=
# Private object storage. Supabase is the default and keeps legacy paths compatible.
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=dolend-payments
# Set these server-only values when STORAGE_PROVIDER=s3. S3_ENDPOINT is optional for AWS S3.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
# Server-only HMAC secret for rate-limit bucket keys. Use at least 32 random characters per environment.
RATE_LIMIT_PEPPER=
ALLOWED_ORIGINS=http://localhost:3000,https://dolend.web.app
POC_MODE=false
PORT=8000

# Explicit guard used only by the hosted database test script.
DATABASE_TEST_PROJECT_REF=fpbefabsqryxmnmxufjw

# Database migrations use the linked Supabase CLI session, not DATABASE_URL.
# Payment and webhook secrets stay unset until needed.
