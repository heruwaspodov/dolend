{
  "name": "dolend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:dev": "deno run --config supabase/functions/dolend-api/deno.json --allow-env --allow-net --watch supabase/functions/dolend-api/index.ts",
    "api:check": "deno check --config supabase/functions/dolend-api/deno.json supabase/functions/dolend-api/index.ts",
    "api:test": "deno test --allow-env --config supabase/functions/dolend-api/deno.json supabase/functions/dolend-api/app_test.ts",
    "supabase": "supabase",
    "api:smoke": "node scripts/smoke-api.mjs",
    "ui": "shadcn",
    "poc:hosted": "node scripts/poc-hosted.mjs",
    "poc:check": "deno check --config supabase/functions/dolend-compat-poc/deno.json supabase/functions/dolend-compat-poc/index.ts",
    "poc:test": "deno test --allow-env --config supabase/functions/dolend-compat-poc/deno.json supabase/functions/dolend-compat-poc/app_test.ts",
    "build:preview": "NEXT_PUBLIC_POC_EVENT_FIXTURES=true next build",
    "preview:fixture": "node scripts/create-preview-fixture.mjs",
    "test:hosting": "playwright test",
    "hosting:preview": "firebase hosting:channel:deploy t03 --only web --project dolend-apps --expires 7d",
    "db:test": "node scripts/database/local-test.mjs",
    "db:test:hosted": "node scripts/database/hosted-test.mjs",
    "db:catalog": "node scripts/database/catalog.mjs",
    "db:types": "node scripts/database/generate-types.mjs",
    "test:landing": "playwright test tests/landing.spec.ts",
    "hosting:deploy": "firebase deploy --only hosting:web --project dolend-apps",
    "ci:stamp": "node scripts/ci/stamp-release.mjs",
    "ci:verify-export": "node scripts/ci/verify-export.mjs",
    "ci:verify-live": "node scripts/ci/verify-live.mjs",
    "test:demo": "playwright test tests/demo.spec.ts"
  },
  "engines": {
    "node": ">=22.14.0 <23 || >=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "deno": "2.9.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "15.34.1",
    "postcss": "8.5.32",
    "shadcn": "4.22.1",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
